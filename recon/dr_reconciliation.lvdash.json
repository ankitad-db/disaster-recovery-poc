{
  "datasets": [
    {
      "name": "summary",
      "displayName": "latest run",
      "queryLines": [
        "SELECT readiness, mode, replication_state,\n             rpo_lag_ms/1000.0 AS rpo_lag_s, rpo_target_ms/1000.0 AS rpo_target_s,\n             ROUND(100.0*objects_ok/NULLIF(objects_in_scope,0),1) AS pct_in_sync,\n             objects_in_scope, objects_ok, objects_attention, blocking_errors,\n             effective_primary_region, failover_group\n           FROM dr_recon.control.dr_recon_runs WHERE run_id = (SELECT run_id FROM dr_recon.control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1)"
      ]
    },
    {
      "name": "coverage",
      "displayName": "coverage",
      "queryLines": [
        "SELECT object_type, status, cnt FROM dr_recon.control.dr_recon_coverage WHERE run_id = (SELECT run_id FROM dr_recon.control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1)"
      ]
    },
    {
      "name": "status_dist",
      "displayName": "status distribution",
      "queryLines": [
        "SELECT status, cnt FROM dr_recon.control.dr_recon_coverage WHERE run_id = (SELECT run_id FROM dr_recon.control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1)"
      ]
    },
    {
      "name": "rpo",
      "displayName": "rpo + activity trend",
      "queryLines": [
        "SELECT run_ts, rpo_lag_ms/1000.0 AS rpo_lag_s,\n             rpo_target_ms/1000.0 AS rpo_target_s, objects_attention FROM dr_recon.control.dr_recon_runs ORDER BY run_ts"
      ]
    },
    {
      "name": "findings",
      "displayName": "blocking findings",
      "queryLines": [
        "SELECT object_type, fqn, error_class, severity, detail\n           FROM dr_recon.control.dr_recon_findings WHERE run_id = (SELECT run_id FROM dr_recon.control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1)"
      ]
    },
    {
      "name": "audit",
      "displayName": "incremental change feed",
      "queryLines": [
        "SELECT event_time, change_type, object_type, fqn,\n             prev_status, new_status FROM dr_recon.control.dr_recon_audit ORDER BY event_time DESC LIMIT 200"
      ]
    },
    {
      "name": "events",
      "displayName": "failover / failback",
      "queryLines": [
        "SELECT event_time, event_type, direction, from_region,\n             to_region, data_loss_window_ms/1000.0 AS data_loss_s, objects_reconciled, objects_total, outcome\n           FROM dr_recon.control.dr_recon_events ORDER BY event_time DESC"
      ]
    },
    {
      "name": "inventory",
      "displayName": "per-object",
      "queryLines": [
        "SELECT object_type, fqn, status, severity, detail, last_reconciled\n           FROM dr_recon.control.dr_recon_inventory WHERE run_id = (SELECT run_id FROM dr_recon.control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1)"
      ]
    }
  ],
