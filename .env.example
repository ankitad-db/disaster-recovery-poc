# Copy to .env and fill in. Never commit .env.
# Databricks CLI profiles (configured via `databricks auth login --profile <name>`).
# These match the `profile:` fields in config/secrets_dr_config.yaml.
DR_EAST_PROFILE=dr-east   # primary  (us-east-2)
DR_WEST_PROFILE=dr-west   # secondary (us-west-2)

# Optional explicit host/token overrides (prefer CLI profiles instead).
# DATABRICKS_HOST=https://fe-sandbox-fe-sandbox-ps-dr-wp-us-east-2.cloud.databricks.com
# DATABRICKS_TOKEN=

# AWS credentials for the S3 bundle store + KMS come from the standard boto3 chain
# (env vars, shared profile, or the cluster/instance role) — nothing to set here.

# Path to the secrets DR config (defaults to config/secrets_dr_config.yaml).
SECRETS_DR_CONFIG=config/secrets_dr_config.yaml
