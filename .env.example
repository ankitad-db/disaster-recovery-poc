# Copy to .env and fill in. Never commit .env.
# Databricks CLI profile names (configured via `databricks auth login`)
DR_WEST_PROFILE=dr-west
DR_EAST_PROFILE=dr-east

# Optional explicit host/token overrides (prefer CLI profiles / secret scopes instead)
# DATABRICKS_HOST_WEST=https://fe-sandbox-ps-dr-wp-us-west-2.cloud.databricks.com
# DATABRICKS_TOKEN_WEST=
# DATABRICKS_HOST_EAST=https://fe-sandbox-ps-dr-wp-us-east-1.cloud.databricks.com
# DATABRICKS_TOKEN_EAST=

# Path to the DR config file (defaults to config/dr_config.yaml)
DR_CONFIG=config/dr_config.yaml
