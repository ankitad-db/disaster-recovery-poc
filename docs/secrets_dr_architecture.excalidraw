      "fontSize": 11,
      "fontFamily": 3,
      "text": "* Values are envelope-encrypted client-side -> plaintext never lands in S3.\n* CRR is the transport for the encrypted bundle (bidirectional = failover+failback).\n* No secondary compute in steady state; import only after promotion (writes allowed).\n* SDK-only + config-driven -> same code runs in notebook / job / locally.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Values are envelope-encrypted client-side -> plaintext never lands in S3.\n* CRR is the transport for the encrypted bundle (bidirectional = failover+failback).\n* No secondary compute in steady state; import only after promotion (writes allowed).\n* SDK-only + config-driven -> same code runs in notebook / job / locally.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 11
    }
