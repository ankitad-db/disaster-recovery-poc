      "fontSize": 11,
      "fontFamily": 3,
      "text": "import base64\nresp = w.secrets.get_secret(scope='app_prod', key='db_pass')   # NEW API\nplaintext = base64.b64decode(resp.value)                       # bytes\ndk  = kms.generate_data_key(KeyId=alias, KeySpec='AES_256',\n        EncryptionContext={'scope':'app_prod','key':'db_pass'})\nct  = AESGCM(dk['Plaintext']).encrypt(nonce, plaintext, aad)   # plaintext never on S3",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import base64\nresp = w.secrets.get_secret(scope='app_prod', key='db_pass')   # NEW API\nplaintext = base64.b64decode(resp.value)                       # bytes\ndk  = kms.generate_data_key(KeyId=alias, KeySpec='AES_256',\n        EncryptionContext={'scope':'app_prod','key':'db_pass'})\nct  = AESGCM(dk['Plaintext']).encrypt(nonce, plaintext, aad)   # plaintext never on S3",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 11
    },
