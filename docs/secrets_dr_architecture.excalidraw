      "fontSize": 12,
      "fontFamily": 2,
      "text": "1. EXPORT job in PRIMARY (us-east-2), run_as ad-dr-spn (needs READ on in-scope scopes). SDK-only; no dbutils; also runnable locally with the dr-east profile.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. EXPORT job in PRIMARY (us-east-2), run_as ad-dr-spn (needs READ on in-scope scopes). SDK-only; no dbutils; also runnable locally with the dr-east profile.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 12
    },
