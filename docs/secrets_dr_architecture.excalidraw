      "fontSize": 20,
      "fontFamily": 2,
      "text": "Workspace Secrets DR \u2014 export-in-PRIMARY \u00b7 system-tables-first \u00b7 KMS envelope + S3 CRR \u00b7 import-on-failover",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workspace Secrets DR \u2014 export-in-PRIMARY \u00b7 system-tables-first \u00b7 KMS envelope + S3 CRR \u00b7 import-on-failover",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 20
    },
    {
      "type": "rectangle",
