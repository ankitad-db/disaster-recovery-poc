      "fontSize": 12,
      "fontFamily": 2,
      "text": "2. DETECT - system-tables-first: scan system.access.audit for putSecret / deleteSecret / create|deleteScope / put|deleteAcl since the last EXPORT watermark. Full state-diff recon (list-scopes/secrets/acls) runs as the safety net.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. DETECT - system-tables-first: scan system.access.audit for putSecret / deleteSecret / create|deleteScope / put|deleteAcl since the last EXPORT watermark. Full state-diff recon (list-scopes/secrets/acls) runs as the safety net.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 12
    },
