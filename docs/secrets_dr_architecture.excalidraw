      "text": "SELECT action_name, request_params.scope AS scope, request_params.key AS secret_key\nFROM system.access.audit\nWHERE service_name = 'secrets'\n  AND action_name IN ('putSecret','deleteSecret','createScope',\n                      'deleteScope','putAcl','deleteAcl')\n  AND workspace_id = '7474660494970929'      -- primary\n  AND event_time >= TIMESTAMP '<last EXPORT watermark>'",
