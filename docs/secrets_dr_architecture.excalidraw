    { "type": "text", "version": 2, "versionNonce": 201, "index": "d1", "id": "e0h",
      "x": 722, "y": 172, "width": 956, "height": 18, "angle": 0,
      "strokeColor": "#0ca678", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 2001, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 2,
      "text": "READ SOURCE + DESTINATION (cross-workspace, no compute on passive)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "READ SOURCE + DESTINATION (cross-workspace, no compute on passive)",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },
    { "type": "text", "version": 2, "versionNonce": 202, "index": "d2", "id": "e0t",
      "x": 722, "y": 194, "width": 956, "height": 110, "angle": 0,
      "strokeColor": "#0ca678", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 2002, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 11, "fontFamily": 3,
      "text": "import base64, hashlib\nsrc = WorkspaceClient(profile='dr-east')        # active / source\ndst = WorkspaceClient(host=peer_host, token=peer_token)  # passive / dest (API only)\nsval = base64.b64decode(src.secrets.get_secret('app_prod','db_pass').value)\nsrc_hash = hashlib.sha256(sval).hexdigest()      # + list_acls('app_prod')",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "import base64, hashlib\nsrc = WorkspaceClient(profile='dr-east')        # active / source\ndst = WorkspaceClient(host=peer_host, token=peer_token)  # passive / dest (API only)\nsval = base64.b64decode(src.secrets.get_secret('app_prod','db_pass').value)\nsrc_hash = hashlib.sha256(sval).hexdigest()      # + list_acls('app_prod')",
      "lineHeight": 1.25, "baseline": 11, "autoResize": false },

    { "type": "rectangle", "version": 2, "versionNonce": 210, "index": "d3", "id": "e1",
      "x": 710, "y": 326, "width": 980, "height": 148, "angle": 0,
      "strokeColor": "#6741d9", "backgroundColor": "#f3f0ff", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 2010,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "type": "text", "version": 2, "versionNonce": 211, "index": "d4", "id": "e1h",
      "x": 722, "y": 334, "width": 956, "height": 18, "angle": 0,
      "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 2011, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 2,
      "text": "DIFF by value hash + ACL signature -> per-key verdict",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "DIFF by value hash + ACL signature -> per-key verdict",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },
    { "type": "text", "version": 2, "versionNonce": 212, "index": "d5", "id": "e1t",
      "x": 722, "y": 356, "width": 956, "height": 110, "angle": 0,
      "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 2012, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 11, "fontFamily": 3,
      "text": "present = key in dst_live\ndst_hash = sha256(b64decode(dst.secrets.get_secret(...).value)) if present else None\nif not present:            verdict = ADD\nelif dst_hash != src_hash: verdict = UPDATE\nelse:                      verdict = SKIP        # unchanged\n# mirror mode: keys in dst but not in src -> DELETE (tombstone)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "present = key in dst_live\ndst_hash = sha256(b64decode(dst.secrets.get_secret(...).value)) if present else None\nif not present:            verdict = ADD\nelif dst_hash != src_hash: verdict = UPDATE\nelse:                      verdict = SKIP        # unchanged\n# mirror mode: keys in dst but not in src -> DELETE (tombstone)",
      "lineHeight": 1.25, "baseline": 11, "autoResize": false },

    { "type": "rectangle", "version": 2, "versionNonce": 220, "index": "d6", "id": "e2",
      "x": 710, "y": 488, "width": 980, "height": 136, "angle": 0,
      "strokeColor": "#e8590c", "backgroundColor": "#fff4e6", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 2020,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "type": "text", "version": 2, "versionNonce": 221, "index": "d7", "id": "e2h",
      "x": 722, "y": 496, "width": 956, "height": 18, "angle": 0,
      "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 2021, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 2,
      "text": "APPLY delta -> destination (over TLS; no S3)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "APPLY delta -> destination (over TLS; no S3)",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },
    { "type": "text", "version": 2, "versionNonce": 222, "index": "d8", "id": "e2t",
      "x": 722, "y": 518, "width": 956, "height": 98, "angle": 0,
      "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 2022, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 11, "fontFamily": 3,
      "text": "for it in to_put:  # ADD / UPDATE only\n    dst.secrets.create_scope(it.scope)          # idempotent\n    dst.secrets.put_secret(it.scope, it.key, it.plaintext)\nfor d in to_delete:  dst.secrets.delete_secret(d.scope, d.key)   # mirror\nfor p,perm in acls:  dst.secrets.put_acl(scope, p, perm)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "for it in to_put:  # ADD / UPDATE only\n    dst.secrets.create_scope(it.scope)          # idempotent\n    dst.secrets.put_secret(it.scope, it.key, it.plaintext)\nfor d in to_delete:  dst.secrets.delete_secret(d.scope, d.key)   # mirror\nfor p,perm in acls:  dst.secrets.put_acl(scope, p, perm)",
      "lineHeight": 1.25, "baseline": 11, "autoResize": false },

    { "type": "rectangle", "version": 2, "versionNonce": 230, "index": "d9", "id": "e3",
