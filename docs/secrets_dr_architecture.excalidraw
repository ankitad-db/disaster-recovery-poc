      "link": null,
      "locked": false,
      "fontSize": 11,
      "fontFamily": 3,
      "text": "b = read_latest('s3://<sec-dr-us-west-2>/secrets')   # local region bucket\nfor it in b['items']:\n    w.secrets.create_scope(it['scope'])              # idempotent\n    w.secrets.put_secret(it['scope'], it['key'], decrypt(it['value']))\nfor s,acls in b['acls'].items():\n    for a in acls: w.secrets.put_acl(s, a['principal'], a['permission'])",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "b = read_latest('s3://<sec-dr-us-west-2>/secrets')   # local region bucket\nfor it in b['items']:\n    w.secrets.create_scope(it['scope'])              # idempotent\n    w.secrets.put_secret(it['scope'], it['key'], decrypt(it['value']))\nfor s,acls in b['acls'].items():\n    for a in acls: w.secrets.put_acl(s, a['principal'], a['permission'])",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 11
    },
