      "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 1020,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "type": "text", "version": 2, "versionNonce": 121, "index": "b3", "id": "s1t",
      "x": 60, "y": 294, "width": 610, "height": 88, "angle": 0,
      "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 1021, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 2,
      "text": "2. READ SOURCE secrets: list scopes/keys, get_secret(scope,key).value (base64 -> bytes), sha256 each for rotation/drift; capture per-scope ACLs via list_acls.",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "2. READ SOURCE secrets: list scopes/keys, get_secret(scope,key).value (base64 -> bytes), sha256 each for rotation/drift; capture per-scope ACLs via list_acls.",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },

    { "type": "rectangle", "version": 2, "versionNonce": 130, "index": "b4", "id": "s2",
      "x": 50, "y": 408, "width": 630, "height": 104, "angle": 0,
      "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 1030,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "type": "text", "version": 2, "versionNonce": 131, "index": "b5", "id": "s2t",
      "x": 60, "y": 416, "width": 610, "height": 88, "angle": 0,
      "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 1031, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 2,
      "text": "3. READ DESTINATION secrets cross-workspace via the Secrets API (WorkspaceClient at the peer host + token). Control-plane reads/writes -> no cluster on the passive side.",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "3. READ DESTINATION secrets cross-workspace via the Secrets API (WorkspaceClient at the peer host + token). Control-plane reads/writes -> no cluster on the passive side.",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },

    { "type": "rectangle", "version": 2, "versionNonce": 140, "index": "b6", "id": "s3",
      "x": 50, "y": 530, "width": 630, "height": 104, "angle": 0,
      "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 1040,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "type": "text", "version": 2, "versionNonce": 141, "index": "b7", "id": "s3t",
      "x": 60, "y": 538, "width": 610, "height": 88, "angle": 0,
      "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 1041, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 2,
      "text": "4. DIFF source vs destination by value_hash + ACL signature -> ADD / UPDATE / DELETE / unchanged. Unchanged keys are skipped (never re-read for value, never rewritten).",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "4. DIFF source vs destination by value_hash + ACL signature -> ADD / UPDATE / DELETE / unchanged. Unchanged keys are skipped (never re-read for value, never rewritten).",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },

    { "type": "rectangle", "version": 2, "versionNonce": 150, "index": "b8", "id": "s4",
