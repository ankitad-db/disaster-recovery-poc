      "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 1050,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "type": "text", "version": 2, "versionNonce": 151, "index": "b9", "id": "s4t",
      "x": 60, "y": 660, "width": 610, "height": 88, "angle": 0,
      "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 1051, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 2,
      "text": "5. APPLY only the delta to the destination: create_scope / put_secret / put_acl / delete_secret / delete_acl. Idempotent (re-run = no-op). FAILOVER = run with roles swapped; the secondary is already a warm mirror, so promotion needs no import.",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "5. APPLY only the delta to the destination: create_scope / put_secret / put_acl / delete_secret / delete_acl. Idempotent (re-run = no-op). FAILOVER = run with roles swapped; the secondary is already a warm mirror, so promotion needs no import.",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },

