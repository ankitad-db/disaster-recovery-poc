      "fontSize": 12,
      "fontFamily": 2,
      "text": "3. READ values via w.secrets.get_secret(scope,key).value (base64 -> decode); sha256 each for rotation detection; capture per-scope ACLs via list_acls.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. READ values via w.secrets.get_secret(scope,key).value (base64 -> decode); sha256 each for rotation detection; capture per-scope ACLs via list_acls.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 12
    },
