    { "type": "text", "version": 2, "versionNonce": 22, "index": "c2", "id": "srct",
      "x": 52, "y": 324, "width": 1656, "height": 62, "angle": 0, "strokeColor": "#0ca678",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 22,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 11, "fontFamily": 3,
      "text": "system.replication.states  (failover-group state, replication_lag_ms/RPO, blocking errors[])   |   DR REST API /api/disaster-recovery/v1  (failover groups + replication SCOPE)\ninformation_schema  x2  (primary + secondary: catalogs/schemas/tables/columns/views/routines/*_privileges)   |   Delta: DESCRIBE DETAIL + HISTORY, SHOW CREATE  (version/rows/size/schema)\nsystem.lakeflow.jobs + Jobs API  (job defs/schedules)   |   Workspace + permissions API  (notebooks/files + ACLs)   |   system.access.audit  (write recency / post-replication-point risk)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "system.replication.states  (failover-group state, replication_lag_ms/RPO, blocking errors[])   |   DR REST API /api/disaster-recovery/v1  (failover groups + replication SCOPE)\ninformation_schema  x2  (primary + secondary: catalogs/schemas/tables/columns/views/routines/*_privileges)   |   Delta: DESCRIBE DETAIL + HISTORY, SHOW CREATE  (version/rows/size/schema)\nsystem.lakeflow.jobs + Jobs API  (job defs/schedules)   |   Workspace + permissions API  (notebooks/files + ACLs)   |   system.access.audit  (write recency / post-replication-point risk)",
      "lineHeight": 1.25, "baseline": 11, "autoResize": false },

