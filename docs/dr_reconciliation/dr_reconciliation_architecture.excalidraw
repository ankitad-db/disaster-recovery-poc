      "fontSize": 20, "fontFamily": 2,
      "text": "DR Reconciliation Report (AWS) - object-level reconciliation + dashboard for Databricks Managed DR",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "DR Reconciliation Report (AWS) - object-level reconciliation + dashboard for Databricks Managed DR",
      "lineHeight": 1.25, "baseline": 20, "autoResize": false },
    { "type": "rectangle", "version": 2, "versionNonce": 2, "index": "a1", "id": "band",
      "x": 40, "y": 60, "width": 1680, "height": 74, "angle": 0, "strokeColor": "#2f9e44",
      "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": { "type": 3 },
      "seed": 2, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "type": "text", "version": 2, "versionNonce": 3, "index": "a2", "id": "bandt",
      "x": 52, "y": 68, "width": 1656, "height": 60, "angle": 0, "strokeColor": "#2f9e44",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 3,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 12, "fontFamily": 2,
      "text": "Managed DR reports only an AGGREGATE replication lag + blocking-error list per failover group (system.replication.states) - it does NOT say, object by object, whether the secondary is a faithful, complete replica. This recon engine diffs the PRIMARY vs the read-only SECONDARY for the top-5 supported object types, classifies each object, and feeds an AI/BI dashboard that answers 'are we truly failover-ready, and where is the drift?'",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "Managed DR reports only an AGGREGATE replication lag + blocking-error list per failover group (system.replication.states) - it does NOT say, object by object, whether the secondary is a faithful, complete replica. This recon engine diffs the PRIMARY vs the read-only SECONDARY for the top-5 supported object types, classifies each object, and feeds an AI/BI dashboard that answers 'are we truly failover-ready, and where is the drift?'",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },

    { "type": "rectangle", "version": 2, "versionNonce": 10, "index": "b0", "id": "prim",
