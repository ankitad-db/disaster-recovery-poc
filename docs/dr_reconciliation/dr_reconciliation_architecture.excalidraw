    { "type": "text", "version": 2, "versionNonce": 31, "index": "d1", "id": "engh",
      "x": 312, "y": 428, "width": 1096, "height": 18, "angle": 0, "strokeColor": "#e8590c",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 31,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 12, "fontFamily": 2,
      "text": "RECON ENGINE - scheduled job (runs in a primary/neutral workspace; reads secondary via the monitor workspace)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "RECON ENGINE - scheduled job (runs in a primary/neutral workspace; reads secondary via the monitor workspace)",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },
    { "type": "text", "version": 2, "versionNonce": 32, "index": "d2", "id": "engt",
      "x": 312, "y": 452, "width": 1096, "height": 118, "angle": 0, "strokeColor": "#e8590c",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 32,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 11, "fontFamily": 3,
      "text": "1. EXPECTED SCOPE  <- DR API + system.replication.states (catalogs, workspace sets in the failover group)\n2. READ PRIMARY    inventory + parity signals per object type (information_schema / DESCRIBE / Jobs / Workspace API)\n3. READ SECONDARY  same reads via the read-only monitor workspace\n4. DIFF per object  by count / commit-version / schema-hash / DDL-hash / grant-set / ACL-set\n5. CLASSIFY + WRITE each object -> IN_SYNC | LAGGING | DRIFTED | MISSING | FAILED | UNSUPPORTED(in-scope)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "1. EXPECTED SCOPE  <- DR API + system.replication.states (catalogs, workspace sets in the failover group)\n2. READ PRIMARY    inventory + parity signals per object type (information_schema / DESCRIBE / Jobs / Workspace API)\n3. READ SECONDARY  same reads via the read-only monitor workspace\n4. DIFF per object  by count / commit-version / schema-hash / DDL-hash / grant-set / ACL-set\n5. CLASSIFY + WRITE each object -> IN_SYNC | LAGGING | DRIFTED | MISSING | FAILED | UNSUPPORTED(in-scope)",
      "lineHeight": 1.25, "baseline": 11, "autoResize": false },

