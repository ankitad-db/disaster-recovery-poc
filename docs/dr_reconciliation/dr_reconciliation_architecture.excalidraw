    { "type": "text", "version": 2, "versionNonce": 11, "index": "b1", "id": "primt",
      "x": 52, "y": 160, "width": 716, "height": 92, "angle": 0, "strokeColor": "#1971c2",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 11,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 12, "fontFamily": 2,
      "text": "PRIMARY (us-east-2) - ACTIVE workspace + UC metastore\nSource of truth. Managed DR replicates: UC managed tables (+data), external tables/volumes (metadata), views, functions, ALL grants; workspace assets (notebooks, jobs, warehouses, clusters, draft dashboards, files) + ACLs.",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "PRIMARY (us-east-2) - ACTIVE workspace + UC metastore\nSource of truth. Managed DR replicates: UC managed tables (+data), external tables/volumes (metadata), views, functions, ALL grants; workspace assets (notebooks, jobs, warehouses, clusters, draft dashboards, files) + ACLs.",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },

    { "type": "rectangle", "version": 2, "versionNonce": 12, "index": "b2", "id": "sec",
      "x": 940, "y": 152, "width": 780, "height": 108, "angle": 0, "strokeColor": "#6741d9",
