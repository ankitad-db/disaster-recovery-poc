    { "type": "text", "version": 2, "versionNonce": 13, "index": "b3", "id": "sect",
      "x": 952, "y": 160, "width": 756, "height": 92, "angle": 0, "strokeColor": "#6741d9",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 13,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "fontSize": 12, "fontFamily": 2,
      "text": "SECONDARY (us-west-2) - READ-ONLY replica (no compute on the secondary)\n+ READ-ONLY MONITOR workspace bound to the secondary metastore -> this is where the recon engine's secondary-side reads (information_schema, DESCRIBE) execute.",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "SECONDARY (us-west-2) - READ-ONLY replica (no compute on the secondary)\n+ READ-ONLY MONITOR workspace bound to the secondary metastore -> this is where the recon engine's secondary-side reads (information_schema, DESCRIBE) execute.",
      "lineHeight": 1.25, "baseline": 12, "autoResize": false },

