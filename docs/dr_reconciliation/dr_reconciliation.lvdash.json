{
  "datasets": [
    {
      "name": "summary",
      "displayName": "latest run summary",
      "queryLines": [
        "SELECT rpo_lag_ms/1000.0 AS rpo_lag_s, rpo_target_ms/1000.0 AS rpo_target_s, readiness, objects_in_scope, objects_ok, objects_attention, blocking_errors, ROUND(100.0*objects_ok/objects_in_scope,1) AS pct_in_sync, effective_primary_region, failover_group FROM dr_poc.dr_control.dr_recon_runs WHERE run_id = (SELECT run_id FROM dr_poc.dr_control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1)"
      ]
    },
    {
      "name": "coverage",
      "displayName": "coverage",
      "queryLines": [
        "SELECT object_type, status, cnt FROM dr_poc.dr_control.dr_recon_coverage WHERE run_id = (SELECT run_id FROM dr_poc.dr_control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1)"
      ]
    },
    {
      "name": "rpo",
      "displayName": "rpo trend",
      "queryLines": [
        "SELECT run_ts, rpo_lag_ms/1000.0 AS rpo_lag_s, rpo_target_ms/1000.0 AS rpo_target_s FROM dr_poc.dr_control.dr_recon_runs ORDER BY run_ts"
      ]
    },
    {
      "name": "errors",
      "displayName": "blocking errors",
      "queryLines": [
        "SELECT error_class, COUNT(*) AS cnt FROM dr_poc.dr_control.dr_recon_findings WHERE run_id = (SELECT run_id FROM dr_poc.dr_control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1) AND severity <> 'INFO' GROUP BY error_class"
      ]
    },
    {
      "name": "inventory",
      "displayName": "per-object",
      "queryLines": [
        "SELECT object_type, fqn, status, severity, detail FROM dr_poc.dr_control.dr_recon_inventory WHERE run_id = (SELECT run_id FROM dr_poc.dr_control.dr_recon_runs ORDER BY run_ts DESC LIMIT 1)"
      ]
    }
  ],
