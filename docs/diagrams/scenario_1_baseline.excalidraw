      "fontSize": 11,
      "fontFamily": 3,
      "text": "# WEST job (destination). Forward direction: source = EAST.\nhost  = dbutils.secrets.get('dr_remote_east','host')   # https://fevm-fevm-ps-dr-us-east-2.cloud.databricks.com\ntoken = dbutils.secrets.get('dr_remote_east','token')  # EAST PAT, read on dr_poc.ml\nwith _ambient_identity(host, token):        # DATABRICKS_HOST/TOKEN -> EAST\n    client = MlflowClient(registry_uri='databricks-uc')   # now reads EAST\n    client.search_model_versions(\"name='dr_poc.ml.iris_dr_model'\")\n# artifacts+runs stream via API -> s3://vdm-classic-pxl08i-ext-s3-049629455384-bz222e/dr_staging/dr/primary/...\n# IMPORT then runs under the LOCAL (WEST) identity (ambient reset)",
      "textAlign": "left",
