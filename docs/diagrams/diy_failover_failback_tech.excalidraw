      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 11,
      "fontFamily": 2,
      "text": "Each bucket is only LOCAL staging for its own region's importer. The delta already arrives via the MLflow API and is written locally, so copying bucket->bucket would double-move data. CRR is only relevant if you abandon pull for a push/bridge model.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e_note",
      "originalText": "Each bucket is only LOCAL staging for its own region's importer. The delta already arrives via the MLflow API and is written locally, so copying bucket->bucket would double-move data. CRR is only relevant if you abandon pull for a push/bridge model.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 11
    },
