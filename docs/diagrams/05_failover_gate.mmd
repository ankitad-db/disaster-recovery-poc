---
title: Failover - Readiness Gate & Role Flip (runs in WEST)
---
flowchart TD
    START["run_failover (in WEST)<br/>NO pull - WEST is warm mirror"] --> PRE["assess_replication (WEST local)<br/>present? dest_max &ge; watermark? recent failures?<br/>compute RPO"]
    PRE --> BLK{"blockers?<br/>(model absent / nothing in scope)"}
    BLK -- none --> FLIP
    BLK -- "yes" --> FORCE{"force = true?"}
    FORCE -- no --> STOP["BLOCKED -> audit FAILED<br/>fix mirror or set force=true"]
    FORCE -- "yes (true disaster)" --> FLIP

    FLIP["write dr_state.active_primary = west"] --> VER["read back & verify flip persisted"]
    VER --> OK["FAILOVER SUCCESS<br/>record RPO + warnings<br/>repoint consumers to WEST"]

    classDef ok fill:#e6f4ea,stroke:#137333,color:#0b3d1f;
    classDef bad fill:#fce8e6,stroke:#a50e0e,color:#5c0a0a;
    class FLIP,VER,OK ok;
    class STOP bad;
