      "fontSize": 11,
      "fontFamily": 3,
      "text": "host  = dbutils.secrets.get('dr_remote_east','host')   # https://fevm-fevm-ps-dr-us-east-2.cloud.databricks.com\ntoken = dbutils.secrets.get('dr_remote_east','token')\nwith _ambient_identity(host, token):     # -> EAST\n    run_replicate(full=False, delete_model=False, skip_versions={iris:{1,2}, wine:{1,2,3}})\n# only iris v3 artifact + wine alias metadata stream -> s3://vdm-classic-pxl08i-ext-s3-049629455384-bz222e/dr_staging",
      "textAlign": "left",
