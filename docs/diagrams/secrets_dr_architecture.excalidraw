      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "1. EXPORT runs in the PRIMARY (east) on a schedule \u2014 compute + READ are available here (no dependency on the read-only secondary). SPN needs READ on each in-scope scope.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. EXPORT runs in the PRIMARY (east) on a schedule \u2014 compute + READ are available here (no dependency on the read-only secondary). SPN needs READ on each in-scope scope.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 12
    },
