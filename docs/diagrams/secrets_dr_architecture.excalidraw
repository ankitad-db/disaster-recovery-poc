      "text": "# CLI (>=0.205), needs READ on the scope:\ndatabricks secrets get-secret app_prod db_pass | jq -r .value | base64 --decode\n# SDK (used by the export job in PRIMARY):\nimport base64; from databricks.sdk import WorkspaceClient\nr = WorkspaceClient().secrets.get_secret(scope='app_prod', key='db_pass')\nplaintext = base64.b64decode(r.value).decode()\n# dbutils.secrets.get(...) is still REDACTED in notebooks -> export uses SDK/CLI",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# CLI (>=0.205), needs READ on the scope:\ndatabricks secrets get-secret app_prod db_pass | jq -r .value | base64 --decode\n# SDK (used by the export job in PRIMARY):\nimport base64; from databricks.sdk import WorkspaceClient\nr = WorkspaceClient().secrets.get_secret(scope='app_prod', key='db_pass')\nplaintext = base64.b64decode(r.value).decode()\n# dbutils.secrets.get(...) is still REDACTED in notebooks -> export uses SDK/CLI",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 11
