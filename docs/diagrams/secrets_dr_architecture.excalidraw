      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 11,
      "fontFamily": 3,
      "text": "s3://<sec-dr-bucket>-us-east-2/secrets/2026-07-17T.../ \n   values.enc.json     # {scope/key -> ciphertext}, KMS-encrypted\n   manifest.json       # scope/key/ACL shape (no plaintext)\n   _latest.txt         # newest bundle pointer\n  --CRR-->  s3://<sec-dr-bucket>-us-west-2/secrets/...   (AWS replicates automatically)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "s3://<sec-dr-bucket>-us-east-2/secrets/2026-07-17T.../ \n   values.enc.json     # {scope/key -> ciphertext}, KMS-encrypted\n   manifest.json       # scope/key/ACL shape (no plaintext)\n   _latest.txt         # newest bundle pointer\n  --CRR-->  s3://<sec-dr-bucket>-us-west-2/secrets/...   (AWS replicates automatically)",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 11
    },
