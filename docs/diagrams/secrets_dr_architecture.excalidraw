      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "3. BUNDLE + ENCRYPT: write values + manifest to the PRIMARY S3 bucket under secrets/ (SSE-KMS). Bundle is the transfer unit (like the models export).",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. BUNDLE + ENCRYPT: write values + manifest to the PRIMARY S3 bucket under secrets/ (SSE-KMS). Bundle is the transfer unit (like the models export).",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 12
    },
