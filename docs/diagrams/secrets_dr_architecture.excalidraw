      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "2. Read VALUES with the new API: w.secrets.get_secret(scope,key).value (base64) for every scope/key; also capture SHAPE + ACLs via list-scopes / list-secrets / list-acls.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Read VALUES with the new API: w.secrets.get_secret(scope,key).value (base64) for every scope/key; also capture SHAPE + ACLs via list-scopes / list-secrets / list-acls.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 12
    },
