      "fontSize": 11,
      "fontFamily": 3,
      "text": "dr_remote_east / dr_remote_west (host+PAT) are secrets too \u2014 include them in the\nbundle so the models pull/failback job can authenticate after promotion.\nAlt to CRR: AWS Secrets Manager multi-region (no bucket/CRR) \u2014 still valid, pick one.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dr_remote_east / dr_remote_west (host+PAT) are secrets too \u2014 include them in the\nbundle so the models pull/failback job can authenticate after promotion.\nAlt to CRR: AWS Secrets Manager multi-region (no bucket/CRR) \u2014 still valid, pick one.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 11
    }
