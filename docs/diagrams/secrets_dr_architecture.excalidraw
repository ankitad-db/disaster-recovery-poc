      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "5. FAILOVER: promoted WEST reads the bundle from its LOCAL (west) bucket, decrypts, and w.secrets.put_secret to (re)create scopes + w.secrets.put_acl to re-apply ACLs. Writes are allowed once promoted.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. FAILOVER: promoted WEST reads the bundle from its LOCAL (west) bucket, decrypts, and w.secrets.put_secret to (re)create scopes + w.secrets.put_acl to re-apply ACLs. Writes are allowed once promoted.",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 12
    },
