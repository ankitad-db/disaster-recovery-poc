    {
      "type": "text",
      "version": 1,
      "versionNonce": 61898651,
      "index": "t",
      "id": "band_t",
      "x": 62,
      "y": 72,
      "width": 1576,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
