      "link": null,
      "locked": false,
      "fontSize": 11,
      "fontFamily": 3,
      "text": "b = read_latest('s3://<sec-dr-bucket>-us-west-2/secrets')   # local region bucket\nfor scope,key,ct in b.values:\n    w.secrets.create_scope(scope)            # idempotent\n    w.secrets.put_secret(scope, key, string_value=decrypt(ct))\nfor a in b.manifest.acls:\n    w.secrets.put_acl(a.scope, a.principal, a.permission)   # principals must exist in WS",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "b = read_latest('s3://<sec-dr-bucket>-us-west-2/secrets')   # local region bucket\nfor scope,key,ct in b.values:\n    w.secrets.create_scope(scope)            # idempotent\n    w.secrets.put_secret(scope, key, string_value=decrypt(ct))\nfor a in b.manifest.acls:\n    w.secrets.put_acl(a.scope, a.principal, a.permission)   # principals must exist in WS",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 11
    },
