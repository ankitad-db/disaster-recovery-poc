      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "4. BIDIRECTIONAL S3 CRR: east bucket -> west bucket keeps the secondary region current continuously; west -> east covers failback. (This is the a-d bucket/EL/CRR ticket.)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. BIDIRECTIONAL S3 CRR: east bucket -> west bucket keeps the secondary region current continuously; west -> east covers failback. (This is the a-d bucket/EL/CRR ticket.)",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 12
    },
