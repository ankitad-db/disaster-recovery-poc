      "fontSize": 20,
      "fontFamily": 2,
      "text": "Workspace Secrets DR \u2014 export-from-PRIMARY (new get-secret API) + S3 CRR + import-on-failover",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workspace Secrets DR \u2014 export-from-PRIMARY (new get-secret API) + S3 CRR + import-on-failover",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 20
    },
    {
