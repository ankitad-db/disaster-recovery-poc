---
title: End-to-End Phase Flow
---
flowchart TD
    P0["Phase 0 - Bootstrap<br/>00_setup in BOTH workspaces<br/>catalog + control tables + staging volume<br/>dr_state = east"]
    P1["Phase 1 - Baseline (full)<br/>run in WEST<br/>EAST to WEST, delete_model=true<br/>exact mirror, watermark = source max"]
    P2["Phase 2 - Steady-state CDC (delta)<br/>run in WEST, scheduled<br/>EAST to WEST, append-only<br/>only changed models move"]
    D{"EAST healthy?"}
    P3["Phase 3 - FAILOVER<br/>run in WEST, no pull<br/>preflight + RPO, flip dr_state=west"]
    P4["Phase 4 - Run on WEST (active)<br/>users author on WEST<br/>EAST down"]
    P5["Phase 5 - Reverse CDC<br/>quiesce WEST, run in EAST<br/>WEST to EAST, catch up"]
    P6["Phase 6 - FAILBACK<br/>run in EAST<br/>verify caught up, reset dr_state=east"]

    P0 --> P1 --> P2 --> D
    D -- yes --> P2
    D -- "no (disaster / drill)" --> P3
    P3 --> P4 --> P5 --> P6 --> P2

    classDef steady fill:#e6f4ea,stroke:#137333,color:#0b3d1f;
    classDef dr fill:#fce8e6,stroke:#a50e0e,color:#5c0a0a;
    class P0,P1,P2 steady;
    class P3,P4,P5,P6 dr;
