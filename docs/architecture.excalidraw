      "type": "text",
      "id": "t69",
      "text": "FAILOVER (run in WEST):  no pull (primary may be down) \u2014 west already warm; readiness/RPO gate; write FAILOVER row; dr_state \u2192 west.  Repoint consumers.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FAILOVER (run in WEST):  no pull (primary may be down) \u2014 west already warm; readiness/RPO gate; write FAILOVER row; dr_state \u2192 west.  Repoint consumers.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
